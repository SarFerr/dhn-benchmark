    given-names: Andrea
version: v1.0.0
date-released: 2026-11-03
doi: 10.5281/zenodo.23922473
repository-code: "https://github.com/SarFerr/dhn-benchmark"
license: GPL-3.0-only
keywords:
  - district heating
  - benchmark
  - synthetic networks
  - thermo-hydraulic simulation
