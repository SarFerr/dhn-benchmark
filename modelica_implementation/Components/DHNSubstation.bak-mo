within modelica_implementation.Components;

model DHNSubstation
  "Indirect heating energy transfer station — standalone replication of
   Buildings.DHC.ETS.Heating.Indirect (PartialIndirect + Indirect).
   Modified: added senTDisSupVal between conVal and hex,
   and yVal_ext input to allow direct valve control bypassing PID.
  "

  replaceable package MediumSer = Buildings.Media.Water
    "District heating medium (primary side)";

  replaceable package MediumBui = Buildings.Media.Water
    "Building heating medium (secondary side)";

  parameter Modelica.Units.SI.MassFlowRate mDis_flow_nominal(final min = 0)
    "Nominal mass flow rate of district side [kg/s]";

  parameter Modelica.Units.SI.MassFlowRate mBui_flow_nominal(final min = 0)
    "Nominal mass flow rate of building side [kg/s]";

  parameter Modelica.Units.SI.PressureDifference dpConVal_nominal(
    final min = 0, displayUnit = "Pa") = 6000
    "Nominal pressure drop of fully open control valve [Pa]";

  parameter Modelica.Units.SI.PressureDifference dp1_nominal(
    final min = 0, displayUnit = "Pa")
    "Nominal pressure difference on primary side [Pa]";

  parameter Modelica.Units.SI.PressureDifference dp2_nominal(
    final min = 0, displayUnit = "Pa")
    "Nominal pressure difference on secondary side [Pa]";

  parameter Boolean use_Q_flow_nominal = true
    "Set to true to specify Q_flow_nominal and temperatures";

  parameter Modelica.Units.SI.HeatFlowRate Q_flow_nominal
    "Nominal heat transfer district to building [W]";

  parameter Modelica.Units.SI.Temperature T_a1_nominal(
    final min = 273.15, final max = 373.15)
    "Nominal temperature at port a1 (district supply) [K]";

  parameter Modelica.Units.SI.Temperature T_a2_nominal(
    final min = 273.15, final max = 373.15)
    "Nominal temperature at port a2 (building return) [K]";

  parameter Modelica.Units.SI.Efficiency eta(
    final min = 0, final max = 1) = 0.8
    "Constant effectiveness";

  parameter Modelica.Blocks.Types.SimpleController controllerType =
    Modelica.Blocks.Types.SimpleController.PI
    "Type of controller";

  parameter Real k(final min = 0, final unit = "1") = 1
    "Gain of controller";

  parameter Modelica.Units.SI.Time Ti(final min = Modelica.Constants.small) = 120
    "Time constant of integrator block [s]";

  parameter Modelica.Units.SI.Time Td(final min = 0) = 0.1
    "Time constant of derivative block [s]";

  parameter Real yMax = 1
    "Upper limit of output";

  parameter Real yMin = 0.0
    "Lower limit of output — 0 allows full valve closure";

protected
  final parameter MediumSer.ThermodynamicState sta_default =
    MediumSer.setState_pTX(
      T = MediumSer.T_default,
      p = MediumSer.p_default,
      X = MediumSer.X_default)
    "Medium state at default properties";

  final parameter Modelica.Units.SI.SpecificHeatCapacity cp_default =
    MediumSer.specificHeatCapacityCp(sta_default)
    "Specific heat capacity of the fluid [J/(kg·K)]";

public
  // ---------------------------------------------------------------
  // External fluid ports
  // ---------------------------------------------------------------
  Modelica.Fluid.Interfaces.FluidPort_a port_aSerHea(
    redeclare package Medium = MediumSer)
    "District supply inlet" annotation(
    Placement(transformation(origin = {-300, -240}, extent = {{-10,-10},{10,10}}),
    iconTransformation(origin = {-100, -60}, extent = {{-10,-10},{10,10}})));

  Modelica.Fluid.Interfaces.FluidPort_b port_bSerHea(
    redeclare package Medium = MediumSer)
    "District return outlet" annotation(
    Placement(transformation(origin = {300, -240}, extent = {{-10,-10},{10,10}}),
    iconTransformation(origin = {100, -60}, extent = {{-10,-10},{10,10}})));

  Modelica.Fluid.Interfaces.FluidPort_a port_aHeaWat(
    redeclare package Medium = MediumBui)
    "Building return inlet" annotation(
    Placement(transformation(origin = {-300, 260}, extent = {{-10,-10},{10,10}}),
    iconTransformation(origin = {-100, 60}, extent = {{-10,-10},{10,10}})));

  Modelica.Fluid.Interfaces.FluidPort_b port_bHeaWat(
    redeclare package Medium = MediumBui)
    "Building supply outlet" annotation(
    Placement(transformation(origin = {300, 260}, extent = {{-10,-10},{10,10}}),
    iconTransformation(origin = {100, 60}, extent = {{-10,-10},{10,10}})));

  // ---------------------------------------------------------------
  // Signal ports
  // ---------------------------------------------------------------
  Modelica.Blocks.Interfaces.RealInput TBuiSupSet
    "Setpoint temperature for building supply [K]" annotation(
    Placement(transformation(extent = {{-340,-20},{-300,20}}),
    iconTransformation(origin = {50,0}, extent = {{-170,-10},{-150,10}})));

  // ADDED: external valve position override — bypasses PID
  // Connect from DHNBuilding to control valve directly from load signal
  // = 0 → valve fully closed → fluid stagnant downstream → T drops to TGround
  // = 1 → valve fully open
  Modelica.Blocks.Interfaces.RealInput yVal_ext(final unit = "1")
    "External valve position [0..1] — bypasses PID" annotation(
    Placement(transformation(extent = {{-340,-80},{-300,-40}}),
    iconTransformation(origin = {50,-40}, extent = {{-170,-10},{-150,10}})));

  Modelica.Blocks.Interfaces.RealOutput Q_flow(
    final quantity = "HeatFlowRate",
    final unit     = "W",
    displayUnit    = "kW")
    "Measured heating demand at the ETS [W]" annotation(
    Placement(transformation(extent = {{300,-140},{340,-100}}),
    iconTransformation(origin = {-50,50}, extent = {{150,-70},{170,-50}})));

  Modelica.Blocks.Interfaces.RealOutput Q(
    final quantity = "Energy",
    final unit     = "J",
    displayUnit    = "kW.h")
    "Measured energy consumption at the ETS [J]" annotation(
    Placement(transformation(extent = {{300,-180},{340,-140}}),
    iconTransformation(origin = {-50,50}, extent = {{150,-90},{170,-70}})));

  // ---------------------------------------------------------------
  // Primary side components
  // ---------------------------------------------------------------
  Buildings.Fluid.Sensors.TemperatureTwoPort senTDisSup(
    redeclare final package Medium = MediumSer,
    final m_flow_nominal = mDis_flow_nominal)
    "District supply temperature sensor" annotation(
    Placement(transformation(extent = {{-220,-290},{-200,-270}})));

  Buildings.Fluid.Sensors.MassFlowRate senMasFlo(
    redeclare final package Medium = MediumSer)
    "District supply mass flow rate sensor" annotation(
    Placement(transformation(extent = {{-160,-290},{-140,-270}})));

  Buildings.Fluid.Actuators.Valves.TwoWayEqualPercentage conVal(
    redeclare final package Medium = MediumSer,
    final m_flow_nominal  = mDis_flow_nominal,
    final dpValve_nominal = dpConVal_nominal,
    strokeTime            = 10,
    y_start               = 0)
    "Control valve — position driven by yVal_ext" annotation(
    Placement(transformation(extent = {{-100,-290},{-80,-270}})));

  // ADDED: sensor downstream of valve = substation primary inlet node
  // With valve closed: fluid stagnant, T drops toward TGround
  // Corresponds to PyDHN/pandapipes substation supply node temperature
  Buildings.Fluid.Sensors.TemperatureTwoPort senTDisSupVal(
    redeclare final package Medium = MediumSer,
    final m_flow_nominal = mDis_flow_nominal)
    "District supply temperature downstream of valve [K]" annotation(
    Placement(transformation(extent = {{-60,-290},{-40,-270}})));

  Buildings.Fluid.HeatExchangers.PlateHeatExchangerEffectivenessNTU hex(
    redeclare package Medium1 = MediumSer,
    redeclare package Medium2 = MediumBui,
    final m1_flow_nominal    = mDis_flow_nominal,
    final m2_flow_nominal    = mBui_flow_nominal,
    final dp1_nominal        = dp1_nominal,
    final dp2_nominal        = dp2_nominal,
    final configuration      = Buildings.Fluid.Types.HeatExchangerConfiguration.CounterFlow,
    final use_Q_flow_nominal = use_Q_flow_nominal,
    final Q_flow_nominal     = Q_flow_nominal,
    final T_a1_nominal       = T_a1_nominal,
    final T_a2_nominal       = T_a2_nominal)
    "Heat exchanger" annotation(
    Placement(transformation(extent = {{0,-200},{20,-220}})));

  Buildings.Fluid.Sensors.TemperatureTwoPort senTDisRet(
    redeclare final package Medium = MediumSer,
    final m_flow_nominal = mDis_flow_nominal)
    "District return temperature sensor" annotation(
    Placement(transformation(extent = {{180,-290},{200,-270}})));

  // ---------------------------------------------------------------
  // Building side components
  // ---------------------------------------------------------------
  Buildings.Fluid.Sensors.TemperatureTwoPort senTBuiRet(
    redeclare final package Medium = MediumBui,
    final m_flow_nominal = mBui_flow_nominal)
    "Building return temperature sensor" annotation(
    Placement(transformation(extent = {{-218,190},{-198,210}})));

  Buildings.Fluid.Sensors.TemperatureTwoPort senTBuiSup(
    redeclare final package Medium = MediumBui,
    final m_flow_nominal = mBui_flow_nominal)
    "Building supply temperature sensor" annotation(
    Placement(transformation(extent = {{-16,-214},{-36,-194}})));

  // ---------------------------------------------------------------
  // PID controller — kept for interface compatibility but overridden
  // by yVal_ext connected directly to conVal.y
  // ---------------------------------------------------------------
  Buildings.Controls.OBC.CDL.Reals.PID con(
    final controllerType = Buildings.Controls.OBC.CDL.Types.SimpleController.PI,
    final k              = k,
    final Ti             = Ti,
    final yMax           = yMax,
    final yMin           = yMin)
    "Building supply temperature controller (output overridden by yVal_ext)" annotation(
    Placement(transformation(extent = {{-130,-230},{-110,-210}})));

  // ---------------------------------------------------------------
  // Q_flow calculation
  // ---------------------------------------------------------------
  Modelica.Blocks.Math.Add dTDis(final k1 = -1)
    "Temperature difference on district side [K]" annotation(
    Placement(transformation(extent = {{20,-124},{40,-104}})));

  Modelica.Blocks.Math.Product pro
    "Product m_flow x dT" annotation(
    Placement(transformation(extent = {{120,-130},{140,-110}})));

  Modelica.Blocks.Math.Gain cp(final k = cp_default)
    "Specific heat multiplier [W]" annotation(
    Placement(transformation(extent = {{180,-130},{200,-110}})));

  Modelica.Blocks.Continuous.Integrator int(final k = 1)
    "Energy integration [J]" annotation(
    Placement(transformation(extent = {{240,-170},{260,-150}})));

equation

  // ---------------------------------------------------------------
  // Primary fluid connections
  // ---------------------------------------------------------------
  connect(port_aSerHea,         senTDisSup.port_a);
  connect(senTDisSup.port_b,    senMasFlo.port_a);
  connect(senMasFlo.port_b,     conVal.port_a);
  connect(conVal.port_b,        senTDisSupVal.port_a);
  connect(senTDisSupVal.port_b, hex.port_a1);
  connect(hex.port_b1,          senTDisRet.port_a);
  connect(senTDisRet.port_b,    port_bSerHea);

  // ---------------------------------------------------------------
  // Building side fluid connections
  // ---------------------------------------------------------------
  connect(port_aHeaWat,      senTBuiRet.port_a);
  connect(senTBuiRet.port_b, hex.port_a2);
  connect(hex.port_b2,       senTBuiSup.port_a);
  connect(senTBuiSup.port_b, port_bHeaWat);

  // ---------------------------------------------------------------
  // PID — connected for interface but output not used
  // ---------------------------------------------------------------
  connect(TBuiSupSet,   con.u_s);
  connect(senTBuiSup.T, con.u_m);
  // con.y NOT connected to conVal.y — overridden by yVal_ext

  // ---------------------------------------------------------------
  // Valve controlled directly by external signal
  // ---------------------------------------------------------------
  connect(yVal_ext, conVal.y);

  // ---------------------------------------------------------------
  // Q_flow calculation
  // ---------------------------------------------------------------
  connect(senTDisSup.T,     dTDis.u2);
  connect(senTBuiRet.T,     dTDis.u1);
  connect(senMasFlo.m_flow, pro.u2);
  connect(dTDis.y,          pro.u1);
  connect(pro.y,            cp.u);
  connect(cp.y,             Q_flow);
  connect(cp.y,             int.u);
  connect(int.y,            Q);

  annotation(
    uses(Buildings(version = "13.0.0"), Modelica(version = "4.1.0")),
    Diagram(coordinateSystem(extent = {{-350,-300},{350,300}})),
    Icon(
      coordinateSystem(extent = {{-100,-100},{100,100}}),
      graphics = {
        Rectangle(
          extent      = {{-100,100},{100,-100}},
          lineColor   = {28,108,200},
          fillColor   = {214,229,255},
          fillPattern = FillPattern.Solid),
        Text(
          extent    = {{-60,30},{60,-10}},
          textString = "ETS",
          textColor  = {28,108,200},
          textStyle  = {TextStyle.Bold},
          fontSize   = 8),
        Text(
          extent    = {{-90,90},{90,-350}},
          textString = "%name",
          textColor  = {28,108,200},
          fontSize   = 8)}),
    version = "");
end DHNSubstation;
